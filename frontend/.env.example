# Plantilla de variables de entorno del frontend de MAR.
# Copiar a .env.local para desarrollo (no se versiona). En Vercel se definen por proyecto
# (oficial y demo). Todas son NEXT_PUBLIC_* y llegan al navegador: NUNCA poner aquí llaves
# secretas (service_role / sb_secret_...).

# Proyecto Supabase del entorno. Vacías → modo demo local con datos sintéticos en JSON.
# En desarrollo, usar el proyecto de la DEMO, no el oficial.
NEXT_PUBLIC_SUPABASE_URL=https://<ref-del-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<clave-publishable-del-proyecto>

# URL pública del sitio (metadatos y respaldo para los enlaces de los correos).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo DEMO: "1" activa el modo demo con base conectada (franja de datos sintéticos y
# recorrido por roles). En el entorno oficial no se define.
NEXT_PUBLIC_DATOS_SINTETICOS=1

# Solo DEMO: cuentas de prueba que se muestran en /ingresar (JSON). En el oficial no se define.
# Formato: [{"rol":"Organización","usuario":"organizacion","email":"<correo>","clave":"<clave>"}]
NEXT_PUBLIC_CUENTAS_PRUEBA=
